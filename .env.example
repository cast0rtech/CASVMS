# ==============================================================================
# CASVMS - Environment Configuration
# ==============================================================================

# InfluxDB 2.7 Credentials & Setup
INFLUXDB_URL=http://influxdb:8086
DOCKER_INFLUXDB_INIT_MODE=setup
DOCKER_INFLUXDB_INIT_USERNAME=casvms_admin
DOCKER_INFLUXDB_INIT_PASSWORD=casvms_password_secure123
DOCKER_INFLUXDB_INIT_ORG=casvms
DOCKER_INFLUXDB_INIT_BUCKET=telemetry
DOCKER_INFLUXDB_INIT_ADMIN_TOKEN=casvms_super_secret_token_123456789_abcdef
INFLUXDB_TOKEN=casvms_super_secret_token_123456789_abcdef
INFLUXDB_ORG=casvms
INFLUXDB_BUCKET=telemetry

# Grafana Configuration
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin
GF_USERS_ALLOW_SIGN_UP=false

# MQTT Broker (Mosquitto)
MQTT_BROKER=mosquitto
MQTT_PORT=1883

# Modbus TCP Settings (Internal Server)
MODBUS_HOST=0.0.0.0
MODBUS_PORT=5020

# External PLC Modbus TCP Barrier Settings (Siemens LOGO! / WAGO)
PLC_MODBUS_HOST=192.168.1.50
PLC_MODBUS_PORT=502
PLC_MODBUS_SLAVE=1
PLC_BARRIER_COIL=0

# ONVIF IP Camera Imaging & Shutter Settings (Hikvision / Dahua / Axis)
ONVIF_CAMERA_IP=192.168.1.64
ONVIF_CAMERA_PORT=80
ONVIF_CAMERA_USER=admin
ONVIF_CAMERA_PASS=admin123
ONVIF_DAY_HOUR=7
ONVIF_NIGHT_HOUR=19

# AI Engine / OpenVINO Execution Device (GPU for Intel iGPU, or CPU fallback)
OPENVINO_DEVICE=GPU



